{
  "name": "fleet-commander",
  "private": true,
  "version": "1.0.0-beta.1",
  "description": "Fleet Commander",
  "author": "OneContact",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node tools/free-ports.mjs",
    "dev": "concurrently -k -n flask,vite,electron -c yellow,cyan,magenta \"npm:dev:backend\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:backend": "node tools/dev-backend.mjs",
    "dev:renderer": "vite",
    "dev:electron": "node tools/dev-electron.mjs",
    "build": "tsc -b && vite build",
    "build:backend": "node tools/build-backend.mjs",
    "package": "npm run build && npm run build:backend && electron-builder",
    "package:dir": "npm run build && npm run build:backend && electron-builder --dir",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "format": "prettier --write ./src"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "ie.onecontact.fleetcommander",
    "productName": "Fleet Commander",
    "publish": [
      {
        "provider": "github",
        "owner": "FlameAqua",
        "repo": "Fleet-Commander"
      }
    ],
    "directories": {
      "output": "release-builds",
      "buildResources": "public"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist",
        "to": "spa",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/fleet.ico",
      "artifactName": "Fleet-Commander-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Fleet Commander"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/fleet.ico",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/fleet.ico"
    }
  }
}
